<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- AutoMapper and MediatR inspect these assemblies at runtime. -->
    <TrimmerRootAssembly Include="Application" />
    <TrimmerRootAssembly Include="Domain" />
    <TrimmerRootAssembly Include="Infrastructure" />
    <TrimmerRootAssembly Include="AutoMapper" />
    <TrimmerRootAssembly Include="MediatR" />
    <PackageReference Include="Avalonia.Browser" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.148.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.0" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="5.3.0" PrivateAssets="all" />
    <ProjectReference Include="..\AvaWeather.UI\AvaWeather.UI.csproj" />
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <Content Include="..\SharedAssets\Branding\app-icon.ico" Link="wwwroot\favicon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\docs\preview-weather-colors.png" Link="wwwroot\preview-weather-colors.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
