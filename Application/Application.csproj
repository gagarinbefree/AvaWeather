<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="MediatR" Version="14.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Weather.Localization\Weather.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\SharedAssets\Weather\weather-conditions.json" LogicalName="Application.weather-conditions.json" />
    <EmbeddedResource Include="..\SharedAssets\Themes\*.json" LogicalName="Application.Theming.Themes.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
