<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.gagarinbefree.avaweather</ApplicationId>
    <ApplicationTitle>AvaWeather</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidPrepareForBuildDependsOn>$(AndroidPrepareForBuildDependsOn);PrepareAndroidIcon</AndroidPrepareForBuildDependsOn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <Import Project="Android.Local.props" Condition="Exists('Android.Local.props')" />
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="5.3.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Weather services use reflection for AutoMapper and MediatR registration. -->
    <TrimmerRootAssembly Include="Application" RootMode="All" />
    <TrimmerRootAssembly Include="Domain" RootMode="All" />
    <TrimmerRootAssembly Include="Infrastructure" RootMode="All" />
    <TrimmerRootAssembly Include="AutoMapper" RootMode="All" />
    <TrimmerRootAssembly Include="MediatR" RootMode="All" />
    <ProjectReference Include="..\AvaWeather.UI\AvaWeather.UI.csproj" />
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    <EmbeddedResource Include="appsettings.Development.json" Condition="'$(Configuration)' == 'Debug' and Exists('appsettings.Development.json')" />
    <AndroidResource Include="$(BaseIntermediateOutputPath)android-resources/drawable/icon.png" Link="Resources\drawable\icon.png" />
  </ItemGroup>
  <Target Name="PrepareAndroidIcon">
    <MakeDir Directories="$(BaseIntermediateOutputPath)android-resources/drawable" />
    <Copy SourceFiles="..\SharedAssets\Branding\app-icon.png"
          DestinationFiles="$(BaseIntermediateOutputPath)android-resources/drawable/icon.png"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
